 "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"<div class=\\\"print-heading\\\">\\t\\t\\t\\t<h2><div>QR Demo</div><br><small class=\\\"sub-heading\\\">{{ doc.name }}</small>\\t\\t\\t\\t</h2></div>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"title\", \"print_hide\": 0, \"label\": \"Title\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"<img src=\\\"{{ doc.qr_code }}\\\" alt=\\\"{{ doc.title }}\\\"/>\"}, {\"fieldname\": \"qr_image\", \"print_hide\": 0, \"label\": \"QR Image\"}]",
 "html": "<style>\n  * {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n  }\n\n  @page {\n    size: 100mm 75mm;\n    margin: 0;\n  }\n\n  body {\n    font-family: Arial, sans-serif;\n    background: white;\n  }\n\n  .label-container {\n    /*position: relative;*/\n    /*width: 82.55mm;*/\n    /*height: 40mm;*/\n    background: white;\n    display: flex;\n    align-items: center; \n    /*gap:10px;*/\n    justify-content: center; \n    flex-direction: column;\n    page-break-after: always;\n    page-break-inside: avoid;\n    /*text-align: center;*/\n  }\n.print-format td, .print-format th{\n    padding:2px !important;\n    vertical-align:top !important;\n}\n  .barcode {\n    width: 85mm; \n    height: 45mm;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-top:20px;\n  }\n\n  .barcode img,\n  .barcode svg {\n    width: 100%;\n    height: 100%;\n    /*object-fit: contain;*/\n  }\n\n  .data-block {\n    /*width: 70mm;*/\n    font-size: 7pt;\n    line-height: 1.3;\n    text-align: center;\n  }\n\n  .item-name {\n    font-size: 9pt;\n    font-weight: bold;\n    margin-bottom: 1mm;\n  }\n\n  .data-block table {\n    margin: 0 auto;\n    border-collapse: collapse;\n  }\n\n  .data-block td {\n    padding: 0.4mm 2mm;\n    font-size: 10pt;\n  }\n\n  .data-block td:first-child {\n    text-align: left;\n  }\n\n  .data-block td:nth-child(2) {\n    text-align: center;\n  }\n\n  .data-block td:last-child {\n    text-align: left;\n  }\n\n\n  @media print {\n    * {\n      -webkit-print-color-adjust: exact;\n      print-color-adjust: exact;\n    }\n  }\n</style>\n\n\n\n{% set barcodes = frappe.get_all(\"BarCode\",\n    filters={\"qr_code_generator_id\": doc.name},\n    fields=[\"name\", \"qr_code_generator_id\", \"qr_code\", \"item\", \"uom\"],\n    order_by=\"creation ASC\"\n) %}\n\n{% if barcodes %}\n  {% for qr in barcodes %}\n    {% set item = frappe.get_doc(\"Item\", qr.item) if qr.item else None %}\n    {% set item_name = item.item_name if item else \"N/A\" %}\n    {% set uom = qr.uom or (item.stock_uom if item else \"N/A\") %}\n\n    {# Fetch conversion_factor (No. of Boxes) from Item UOM child table #}\n    {% set ns = namespace(no_of_boxes=None) %}\n{% if item and item.uoms %}\n  {% for uom_row in item.uoms %}\n    {% if uom_row.uom == qr.uom %}\n      {% set ns.no_of_boxes = uom_row.conversion_factor %}\n    {% endif %}\n  {% endfor %}\n{% endif %}\n\n    <div class=\"label-container\">\n\n        <div class=\"barcode\">\n          {% if qr.qr_code %}\n            <img src=\"{{ qr.qr_code }}\" alt=\"QR Code\">\n          {% else %}\n            <svg viewBox=\"0 0 200 40\" xmlns=\"http://www.w3.org/2000/svg\">\n              {% for i in range(5,190,7) %}\n                <rect x=\"{{ i }}\" y=\"0\" width=\"{{ [2,3,4]|random }}\" height=\"35\" fill=\"black\"/>\n              {% endfor %}\n            </svg>\n          {% endif %}\n        </div>\n\n        <div class=\"data-block\">\n          <table>\n            <tr>\n              <td>Item Name</td>\n              <td>:</td>\n              <td>{{ qr.item or 'N/A' }}</td>\n            </tr>\n            <tr>\n              <td>UOM</td>\n              <td>:</td>\n              <td>{{ uom }}</td>\n            </tr>\n            <tr>\n              <td>No. of Boxes</td>\n              <td>:</td>\n              <td>{{ ns.no_of_boxes or 'N/A' }}</td>\n            </tr>\n          </table>\n        </div>\n    </div>\n  {% endfor %}\n{% else %}\n  <div class=\"label-container\">\n    <div class=\"print-area\">\n      <div class=\"data-block\" style=\"top: 17.8mm; text-align: center;\">\n        <p>No valid data to print.</p>\n      </div>\n    </div>\n  </div>\n{% endif %}\n",
